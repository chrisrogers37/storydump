# Neon connection string (same DB as Python backend)
DATABASE_URL=

# Telegram notification for waitlist signups
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# Analytics — Plausible domain (omit to disable analytics)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# The product bot's handle without @, for the site's t.me links
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

# The target API the dashboard's BFF proxies to and the sign-in redirects
# reach (`lib/target-api.ts`). BACKEND_URL is read only when this is unset.
TARGET_API_URL=http://localhost:8000
BACKEND_URL=
