# The secret sent with each waitlist signup so the API limits each visitor on
# their own; the same value as the API's WAITLIST_SITE_SECRET. Unset, the API
# shares one limit across every visitor.
WAITLIST_SITE_SECRET=

# Analytics: the PostHog project's API key (phc_…), from PostHog's Project
# settings. Unset, the site sends no analytics (`src/lib/posthog.ts`).
NEXT_PUBLIC_POSTHOG_KEY=

# The product bot's handle without @, for the site's t.me links
NEXT_PUBLIC_TELEGRAM_BOT_NAME=

# The target API the dashboard's BFF proxies to and the sign-in redirects
# reach (`lib/target-api.ts`). BACKEND_URL is read only when this is unset.
TARGET_API_URL=http://localhost:8000
BACKEND_URL=
